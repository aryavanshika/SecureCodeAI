# =============================================================================
# SecureCode AI - Environment Configuration Example
# Copy to .env and adjust variables as needed.
# =============================================================================

# FastAPI Backend Host and Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Backend REST Endpoint URL (used by Frontend and CLI tools)
SECURECODE_API_ENDPOINT=http://127.0.0.1:8000

# Optional External AI/LLM Providers for Enhanced Security Explanations
# Zero hardcoded keys - if not set, SecureCode AI uses deterministic local rules.
# OPENAI_API_KEY=sk-proj-...
# GEMINI_API_KEY=AIzaSy...
# ANTHROPIC_API_KEY=sk-ant-...

# SQLite Database Location
# DATABASE_PATH=backend/securecode.db
